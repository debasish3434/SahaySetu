# ==========================================
# Sahay Setu Backend - Environment Variables
# Copy this file to .env and fill in your real values
# ==========================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Comma-separated additional browser origins for production (for example, https://app.example.com).
# Production CORS accepts only these origins plus the native Capacitor origins.
CORS_ORIGINS=

# MongoDB Atlas
# Get this from https://cloud.mongodb.com → Connect → Connect your application
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sahay-setu?retryWrites=true&w=majority

# JWT
# Use a long random string (at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# Set these once before first startup to initialize the single platform owner.
# Use your verified email and a unique, strong password; never commit .env.
SUPER_ADMIN_EMAIL=your_verified_email@example.com
SUPER_ADMIN_INITIAL_PASSWORD=replace_with_a_unique_strong_password

# Cloudinary
# Get these from https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting (optional — defaults apply if omitted)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Optional legacy staff email domain; this setting never grants any role or privilege.
STAFF_EMAIL_DOMAIN=sahaysetu.com

# SMTP email delivery for administrator invitations and optional password-reset messages.
# For production, use a provider account and configure SPF, DKIM, and DMARC
# for your sending domain. Never commit SMTP credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=SahaySetu Support
EMAIL_FROM_ADDRESS=support@sahaysetu.com
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Optional Resend delivery for password-reset messages.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Google OAuth client. OAuth must be configured in the application
# before it can be used; these values alone do not enable sign-in.
GOOGLE_CLIENT_ID=
